---
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/global.css';
import PetalLayer from '../components/PetalLayer.astro';
import SiteNav from '../components/SiteNav.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
const { title, description = 'Mark Reizel Vincent C. Palma, full-stack engineer in the Philippines. Payroll, POS and SaaS systems running in production.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <!-- Runs before first paint: pick the season from the visitor's clock and restore the petal pause choice. -->
    <script is:inline>
      (function () {
        var m = new Date().getMonth(), root = document.documentElement;
        root.dataset.season = m >= 2 && m <= 4 ? 'spring' : m >= 8 && m <= 10 ? 'autumn' : 'mixed';
        try { if (localStorage.getItem('petals-paused') === '1') root.classList.add('petals-paused'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <PetalLayer />
    <SiteNav />
    <slot />
    <AnalyticsConsent />
  </body>
</html>
