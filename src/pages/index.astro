---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import RouteMap from '../components/RouteMap.astro';

const EMAIL = 'markvincentpalma01@gmail.com';
const GITHUB = 'https://github.com/binssente-crypto';
const LINKEDIN = 'https://www.linkedin.com/in/mark-reizel-vincent-palma-903253297/';

const [allProjects, credentials] = await Promise.all([
  getCollection('projects'),
  getCollection('credentials'),
]);

// Hackathons stay on the route map but are not counted as shipped projects
const projects = allProjects.filter((p) => !p.data.event);
const byId = Object.fromEntries(allProjects.map((p) => [p.id, p]));

// Selected work: live sites with a landing-page screenshot, in this order
const SELECTED = ['bizmaker-erp', 'omma-platform', 'tlcph'];
const selected = SELECTED.map((id) => byId[id]).filter((p) => p?.data.shot && p.data.links.live);

const more = projects
  .filter((p) => !selected.includes(p))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime());

const stats = [
  { value: projects.filter((p) => p.data.links.live).length, label: 'systems live in production' },
  { value: projects.length, label: 'projects shipped' },
  { value: credentials.length, label: 'credentials earned' },
  { value: Math.min(...projects.map((p) => p.data.date.getUTCFullYear())), label: 'building since' },
];

const experience = [
  {
    role: 'Software Development Associate',
    org: 'AAA and Co., CPAs',
    dates: 'Jun 2026 – Present',
    note: 'Lead developer on the Gamma Oracle project cost-control platform: budgets, contractor payments, withholding tax and audit trails.',
    work: ['gamma-pm'],
  },
  {
    role: 'Software Engineering Intern',
    org: 'Gamma Oracle Dimension Inc.',
    dates: 'Feb 2026 – Jun 2026',
    note: 'Built the BizMaker payroll and HRIS SaaS alone, and co-built the Tax Leaders Circle PH learning portal.',
    work: ['bizmaker-erp', 'tlcph'],
  },
  {
    role: 'Freelance Full-Stack Developer',
    org: 'Independent',
    dates: 'Jan 2024 – Present',
    note: 'Turned paper invoices, attendance sheets and order slips into software for local businesses and student organizations.',
    work: ['omma-platform', 'mafi-receipt', 'bubble-pos', 'galaxent-attendance'],
  },
];

const recognition = [
  { kicker: 'Academic honor · 2026', title: 'Magna Cum Laude, BS Information Systems', text: 'Graduated with high honors from Dr. Filemon C. Aguilar Memorial College while working on client systems.', href: '/notes/graduating-magna-cum-laude', cta: 'Read the note' },
  { kicker: 'Hackathon · July 2026', title: 'eGovPH National Hackathon', text: 'Led team "Println New Gen" through a 48-hour sprint on the government\'s SSO, eVerify and eGovPay APIs.', href: '/projects/egovph-hackathon-2026', cta: 'See the event' },
  { kicker: 'Cisco · 2026', title: 'Junior Cybersecurity Analyst', text: 'Career path covering network defense, endpoint security, threat management and SOC work.', href: '/notes/junior-cybersecurity-analyst-journey', cta: 'Read the note' },
];

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const year = (d: Date) => d.getUTCFullYear();
---

<Base title="Mark Reizel Vincent C. Palma | Full-Stack Engineer">
  <main id="main">
    <!-- Hero -->
    <header class="hero container">
      <div class="hero-text">
        <p class="hero-eyebrow">Mark Reizel Vincent C. Palma <span aria-hidden="true">·</span> Full-stack engineer, Las Piñas PH</p>
        <h1 class="hero-title">I build the payroll, POS and SaaS systems Philippine businesses run on.</h1>
        <p class="hero-lede">
          Software Development Associate at AAA and Co., CPAs. Magna Cum Laude in Information Systems, 2026.
          Shipping for real clients since 2024.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn btn-primary">
            See my work
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
          <a href="/resume" class="btn btn-ghost">Resume</a>
          <span class="hero-icons">
            <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="GitHub (opens in a new tab)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="LinkedIn (opens in a new tab)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            </a>
            <a href={`mailto:${EMAIL}`} class="icon-link" aria-label={`Email ${EMAIL}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </a>
          </span>
        </div>
      </div>

      <div class="hero-portrait">
        <img src="/images/profile.png" alt="Mark Reizel Vincent C. Palma in graduation toga" width="220" height="220" />
      </div>

      <dl class="hero-stats">
        {stats.map((s) => (
          <div class="hero-stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- Selected work on the sumi stage -->
    <section id="work" class="stage" aria-labelledby="work-heading">
      <div class="container">
        <div class="section-head">
          <p class="section-kicker">Selected work</p>
          <h2 id="work-heading" class="section-title">Live in production, used every day</h2>
        </div>

        <ol class="features">
          {selected.map((p, i) => (
            <li class:list={['feature', { 'feature-flip': i % 2 === 1 }]}>
              <a class="feature-shot" href={p.data.links.live} target="_blank" rel="noopener noreferrer" aria-label={`Visit the ${p.data.title} live site (opens in a new tab)`}>
                <span class="browser-bar" aria-hidden="true">
                  <span class="browser-dots"><i></i><i></i><i></i></span>
                  <span class="browser-url">{host(p.data.links.live!)}</span>
                </span>
                <img src={p.data.shot} alt="" width="1440" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>

              <div class="feature-body">
                <p class="feature-kicker">{year(p.data.date)} · {p.data.client}</p>
                <h3 class="feature-title"><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
                <p class="feature-desc">{p.data.outcome}</p>
                <ul class="feature-stack" aria-label="Built with">
                  {p.data.skills.slice(0, 6).map((s) => <li>{s}</li>)}
                </ul>
                <div class="feature-actions">
                  <a href={p.data.links.live} target="_blank" rel="noopener noreferrer" class="btn btn-stage">
                    Visit live site
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                  </a>
                  <a href={`/projects/${p.id}/`} class="stage-link">Case study <span aria-hidden="true">→</span></a>
                  {p.data.links.repo && (
                    <a href={p.data.links.repo} target="_blank" rel="noopener noreferrer" class="stage-link">Code <span aria-hidden="true">↗</span></a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- More projects -->
    <section class="container block" aria-labelledby="more-heading">
      <div class="section-head">
        <p class="section-kicker">More projects</p>
        <h2 id="more-heading" class="section-title">Client systems, capstones and experiments</h2>
      </div>

      <ul class="cards">
        {more.map((p) => (
          <li class="card">
            <div class="card-top">
              <span class="card-logo" aria-hidden="true" style={p.data.logoBg && `background: ${p.data.logoBg}`}>
                {p.data.logo ? <img src={p.data.logo} alt="" width="44" height="44" loading="lazy" decoding="async" /> : <span>{p.data.title.charAt(0)}</span>}
              </span>
              <span class="card-year">{year(p.data.date)}</span>
            </div>
            <h3 class="card-title"><a href={`/projects/${p.id}/`} class="card-link">{p.data.title}</a></h3>
            {p.data.client && <p class="card-client">{p.data.client}</p>}
            <p class="card-desc">{p.data.outcome}</p>
            <ul class="card-stack" aria-label="Built with">
              {p.data.skills.slice(0, 4).map((s) => <li>{s}</li>)}
            </ul>
            <div class="card-links">
              <span class="card-more" aria-hidden="true">Case study →</span>
              {p.data.links.repo && (
                <a href={p.data.links.repo} target="_blank" rel="noopener noreferrer" class="card-code" aria-label={`${p.data.title} source code on GitHub (opens in a new tab)`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                  Code
                </a>
              )}
              {p.data.links.live && (
                <a href={p.data.links.live} target="_blank" rel="noopener noreferrer" class="card-code" aria-label={`${p.data.title} live site (opens in a new tab)`}>Live ↗</a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Experience -->
    <section id="experience" class="container block exp" aria-labelledby="experience-heading">
      <div class="section-head exp-head">
        <p class="section-kicker">Experience</p>
        <h2 id="experience-heading" class="section-title">Where the work happened</h2>
        <a href="/resume" class="exp-resume">Full resume <span aria-hidden="true">→</span></a>
      </div>

      <ol class="exp-list">
        {experience.map((e) => (
          <li class="exp-item">
            <p class="exp-dates">{e.dates}</p>
            <div>
              <h3 class="exp-role">{e.role}</h3>
              <p class="exp-org">{e.org}</p>
              <p class="exp-note">{e.note}</p>
              <ul class="exp-work" aria-label="Projects">
                {e.work.filter((id) => byId[id]).map((id) => (
                  <li><a href={`/projects/${id}/`}>{byId[id].data.title}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Recognition + education -->
    <section class="container block" aria-labelledby="recognition-heading">
      <div class="section-head">
        <p class="section-kicker">Recognition</p>
        <h2 id="recognition-heading" class="section-title">Honors, events and training</h2>
      </div>

      <ul class="recog">
        {recognition.map((r) => (
          <li class="recog-item">
            <p class="recog-kicker">{r.kicker}</p>
            <h3 class="recog-title">{r.title}</h3>
            <p class="recog-text">{r.text}</p>
            <a href={r.href} class="recog-link">{r.cta} <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>

      <p class="edu">
        <strong>Education</strong>
        <span>BS Information Systems, Dr. Filemon C. Aguilar Memorial College of Las Piñas, 2022 – 2026</span>
        <span>TVL-ICT, De La Salle Santiago Zobel School – BRafeNHS, 2016 – 2022</span>
      </p>
    </section>

    <!-- Skills + route map -->
    <section id="journey" class="container block" aria-label="Skills and journey">
      <RouteMap />
    </section>

    <!-- Contact -->
    <footer class="contact container">
      <p class="section-kicker">Contact</p>
      <h2 class="contact-title">Still running a process on paper?<br />Let's build the system that replaces it.</h2>
      <div class="hero-actions">
        <a href={`mailto:${EMAIL}`} class="btn btn-primary">{EMAIL}</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn</a>
        <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
      </div>
      <p class="contact-fine">© {new Date().getFullYear()} Mark Reizel Vincent C. Palma · Built with Astro</p>
    </footer>
  </main>
</Base>

<style>
/* ---------- Shared ---------- */
.block {
  margin-top: var(--space-8);
}

.section-head {
  margin-bottom: var(--space-6);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin: 0 0 var(--space-2);
  color: var(--accent-ink);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Small hanko square before each kicker */
.section-kicker::before {
  content: '';
  width: 9px;
  height: 9px;
  border-radius: 2px;
  background: currentColor;
}

.section-title {
  margin: 0;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.15;
  max-width: 26ch;
  text-wrap: balance;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 46px;
  padding: 0 1.15rem;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  font-size: var(--text-sm);
  font-weight: 700;
  text-decoration: none;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

.btn:active {
  transform: translateY(1px);
}

.btn-primary {
  background: var(--accent-ink);
  color: #FFF;
}

.btn-primary:hover {
  background: color-mix(in srgb, var(--accent-ink) 82%, black);
  color: #FFF;
}

.btn-ghost {
  background: var(--surface);
  border-color: var(--border-strong);
  color: var(--ink);
}

.btn-ghost:hover {
  border-color: var(--ink);
  color: var(--ink);
}

/* ---------- Hero ---------- */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-6) var(--space-7);
  align-items: center;
  padding-top: var(--space-6);
}

.hero-eyebrow {
  margin: 0 0 var(--space-4);
  color: var(--ink-2);
  font-size: var(--text-sm);
  font-weight: 600;
}

.hero-title {
  margin: 0 0 var(--space-5);
  font-size: var(--text-display);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.04;
  max-width: 17ch;
  text-wrap: balance;
}

.hero-lede {
  margin: 0 0 var(--space-6);
  max-width: 58ch;
  color: var(--ink-2);
  font-size: var(--text-lg);
  line-height: 1.55;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
}

.hero-icons {
  display: inline-flex;
  gap: var(--space-1);
  margin-left: var(--space-2);
}

.icon-link {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: var(--radius-sm);
  color: var(--ink-2);
}

.icon-link:hover {
  color: var(--accent-ink);
  background: color-mix(in srgb, var(--accent) 8%, transparent);
}

.hero-portrait img {
  display: block;
  width: clamp(160px, 18vw, 220px);
  height: auto;
  aspect-ratio: 1;
  object-fit: cover;
  object-position: top center;
  border-radius: 50%;
  border: 6px solid var(--surface);
  box-shadow: 0 0 0 1px var(--border), 0 18px 40px rgba(31, 42, 51, 0.16);
  background: var(--surface-2);
}

.hero-stats {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: var(--space-4) 0 0;
  border-top: 1px solid var(--border-strong);
}

.hero-stat {
  display: flex;
  flex-direction: column-reverse; /* number above label; dt stays first for screen readers */
  gap: 0.15rem;
  justify-content: flex-end; /* with column-reverse this keeps numbers top-aligned when a label wraps */
  padding: var(--space-4) var(--space-4) 0 0;
}

.hero-stat + .hero-stat {
  padding-left: var(--space-4);
  border-left: 1px solid var(--border);
}

.hero-stat dd {
  margin: 0;
  font-size: clamp(1.6rem, 3vw, 2.1rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1;
}

.hero-stat dt {
  color: var(--ink-3);
  font-size: var(--text-xs);
  font-weight: 600;
}

@media (max-width: 760px) {
  .hero {
    grid-template-columns: 1fr;
    padding-top: var(--space-2);
  }

  .hero-portrait {
    grid-row: 1;
  }

  .hero-portrait img {
    width: 112px;
  }

  .hero-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-stat + .hero-stat:nth-child(3) {
    padding-left: 0;
    border-left: 0;
  }
}

/* ---------- Sumi stage: selected work ---------- */
.stage {
  --focus-ring: 0 0 0 2px var(--stage), 0 0 0 4px var(--stage-accent);
  margin-top: var(--space-8);
  padding: calc(var(--space-8) + 2rem) 0 calc(var(--space-8) + 2rem);
  color: var(--stage-ink);
  /* Soft edges: the ink fades into the washi instead of ending in a hard line */
  background: linear-gradient(
    to bottom,
    transparent 0,
    var(--stage) 4rem,
    var(--stage) calc(100% - 4rem),
    transparent 100%
  );
}

.stage .section-kicker {
  color: var(--stage-accent);
}

.stage .section-title {
  color: var(--stage-ink);
}

.features {
  display: grid;
  gap: var(--space-8);
  margin: 0;
  padding: 0;
  list-style: none;
}

.feature {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  align-items: center;
}

.feature-shot {
  grid-column: 1 / 8;
  grid-row: 1;
  display: block;
  color: inherit;
  text-decoration: none;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1px solid var(--stage-border);
  background: var(--stage-2);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.feature-shot:hover {
  transform: translateY(-4px);
}

.feature-shot img {
  display: block;
  width: 100%;
  height: auto;
}

.browser-bar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  height: 30px;
  padding: 0 var(--space-3);
  background: #232D36;
  border-bottom: 1px solid var(--stage-border);
}

.browser-dots {
  display: inline-flex;
  gap: 5px;
}

.browser-dots i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(243, 239, 231, 0.22);
}

.browser-url {
  flex: 1;
  max-width: 260px;
  margin-inline: auto;
  padding: 2px 10px;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.25);
  color: var(--stage-ink-2);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.feature-body {
  grid-column: 7 / -1;
  grid-row: 1;
  position: relative;
  z-index: 1;
  text-align: right;
}

.feature-kicker {
  margin: 0 0 var(--space-1);
  color: var(--stage-accent);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
}

.feature-title {
  margin: 0 0 var(--space-4);
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.feature-title a {
  color: var(--stage-ink);
  text-decoration: none;
}

.feature-title a:hover {
  color: var(--stage-accent);
}

.feature-desc {
  margin: 0 0 var(--space-4);
  padding: var(--space-5);
  border-radius: var(--radius-md);
  background: var(--stage-2);
  border: 1px solid var(--stage-border);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  color: var(--stage-ink-2);
  font-size: var(--text-sm);
  line-height: 1.6;
  text-align: left;
}

.feature-stack {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--space-1) var(--space-4);
  margin: 0 0 var(--space-5);
  padding: 0;
  list-style: none;
  color: var(--stage-ink-2);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
}

.feature-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
