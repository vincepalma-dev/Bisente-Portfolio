---
// Harvard-format resume. Content lives in src/data/resume.json, which also feeds
// the PDF / DOCX / Markdown generators in scripts/.
import resume from '../data/resume.json';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';

type Entry = { heading: string; role?: string; right?: string; sub?: string; subRight?: string; url?: string; bullets?: string[] };
type Section = { title: string; lines?: { label: string; text: string }[]; entries?: Entry[] };
const sections = resume.sections as Section[];

// Bullets may hold [label](url) links
const parts = (text: string) =>
  text.split(/(\[[^\]]+\]\([^)]+\))/).map((chunk) => {
    const m = chunk.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { label: m[1], url: m[2] } : { text: chunk };
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mark Reizel Vincent C. Palma - Resume | Full-Stack Software Engineer</title>
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content="Resume of Mark Reizel Vincent C. Palma, full-stack software engineer (Magna Cum Laude, BSIS). Payroll, POS and SaaS systems in production." />
  </head>
  <body>
    <aside class="action-bar" aria-label="Resume actions">
      <div class="action-container">
        <a href="/" class="btn back-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Portfolio
        </a>
        <div class="action-right">
          <a href="/Mark_Reizel_Vincent_Palma_Resume.pdf" download class="btn print-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
          </a>
          <button type="button" onclick="window.print()" class="btn text-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            Print
          </button>
        </div>
      </div>
    </aside>

    <main class="resume-sheet">
      <header class="resume-header">
        <h1 class="candidate-name">{resume.name}</h1>
        <p class="candidate-line">
          {resume.contact.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">|</span>}
              {c.includes('@') ? <a href={`mailto:${c}`}>{c}</a> : c.startsWith('+') ? <a href={`tel:${c.replace(/\s/g, '')}`}>{c}</a> : <span>{c}</span>}
            </>
          ))}
        </p>
        <p class="candidate-line">
          {resume.links.map((l, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">|</span>}
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
            </>
          ))}
        </p>
      </header>

      {sections.map((section) => (
        <section class="resume-section">
          <h2 class="section-title">{section.title}</h2>

          {section.lines && (
            <ul class="lines">
              {section.lines.map((l) => (
                <li><strong>{l.label}:</strong> {l.text}</li>
              ))}
            </ul>
          )}

          {section.entries?.map((e) => (
            <article class="entry">
              <div class="entry-row">
                <h3 class="entry-heading">
                  {e.url ? <a href={e.url} target="_blank" rel="noopener noreferrer" class="plain">{e.heading}</a> : e.heading}
                  {e.role && <span class="entry-role"> | {e.role}</span>}
                </h3>
                {e.right && <span class="entry-right">{e.right}</span>}
              </div>
              {e.sub && (
                <div class="entry-row entry-sub">
                  <span>{e.sub}</span>
                  {e.subRight && (e.url ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.subRight}</a> : <span>{e.subRight}</span>)}
                </div>
              )}
              {e.bullets && (
                <ul class="bullets">
                  {e.bullets.map((b) => (
                    <li>
                      {parts(b).map((p) => ('url' in p ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.label}</a> : p.text))}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>
      ))}
    </main>
    <AnalyticsConsent />
  </body>
</html>

<style>
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #EEF0F2;
  color: #000;
  font-family: 'Times New Roman', Times, serif;
  font-size: 11pt;
  line-height: 1.25;
}

/* SCREEN ACTION BAR */
.action-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 0.75rem 1rem;
  background: #141B21;
  color: #FFF;
  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
}

.action-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  max-width: 820px;
  margin: 0 auto;
}

.action-right {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  min-height: 44px;
  padding: 0 0.9rem;
  border-radius: 6px;
  border: 1px solid transparent;
  font-size: 0.875rem;
  font-weight: 600;
  font-family: inherit;
  text-decoration: none;
  cursor: pointer;
}

.back-btn {
  color: #FFF;
  border-color: rgba(255, 255, 255, 0.25);
}

.back-btn:hover {
  background: rgba(255, 255, 255, 0.1);
}

.text-btn {
  background: #FFF;
  color: #141B21;
}

.text-btn:hover {
  background: #E2E6EA;
}

.print-btn {
  background: #A8341F;
  color: #FFF;
}

.print-btn:hover {
  background: #8A2A19;
}

.btn:focus-visible {
  outline: 3px solid #F0896B;
  outline-offset: 2px;
}

/* SHEET */
.resume-sheet {
  max-width: 820px;
  margin: 2rem auto;
  padding: 2.5rem 3rem;
  background: #FFF;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}

.resume-sheet a {
  color: #000;
  text-underline-offset: 2px;
}

.resume-sheet a.plain,
.resume-header a {
  text-decoration: none;
}

.resume-sheet a:hover {
  text-decoration: underline;
}

.resume-header {
  margin-bottom: 0.5rem;
  text-align: center;
}

.candidate-name {
  margin: 0 0 0.2rem;
  font-size: 16pt;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.candidate-line {
  margin: 0;
}

.sep {
  margin: 0 0.35rem;
}

.resume-section {
  margin-top: 0.7rem;
}

.section-title {
  margin: 0 0 0.3rem;
  padding-bottom: 0.1rem;
  border-bottom: 1px solid #000;
  font-size: 11.5pt;
  font-weight: 700;
  text-transform: uppercase;
}

.lines {
  margin: 0;
  padding: 0;
  list-style: none;
}

.entry + .entry {
  margin-top: 0.35rem;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
}

.entry-heading {
  margin: 0;
  font-size: inherit;
  font-weight: 700;
}

.entry-role {
  font-weight: 400;
}

.entry-right {
  white-space: nowrap;
}

.entry-sub {
  font-style: italic;
}

.bullets {
  margin: 0.1rem 0 0;
  padding-left: 1.25rem;
  list-style: disc;
}

@media (max-width: 640px) {
  .resume-sheet {
    margin: 0;
    padding: 1.5rem 1rem;
    box-shadow: none;
  }

  .entry-row {
    flex-direction: column;
    gap: 0;
  }
}

/* PRINT (browser print-to-PDF) */
@media print {
  @page {
    size: A4;
    margin: 0.45in 0.5in;
  }

  body {
    background: #FFF;
    font-size: 10pt;
  }

  .action-bar {
    display: none;
  }

  .resume-sheet {
    max-width: none;
    margin: 0;
    padding: 0;
    box-shadow: none;
  }

  /* Never strand a section heading at a page bottom, and don't split an entry or skill list */
  .section-title {
    break-after: avoid;
    break-inside: avoid;
  }

  /* Chrome ignores break-after: avoid here; reserving space under the heading moves it to the next page instead */
  .section-title::after {
    content: '';
    display: block;
    height: 4.5em;
    margin-bottom: -4.5em;
  }

  .entry,
  .lines {
    break-inside: avoid;
  }
}
</style>
