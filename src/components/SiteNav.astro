---
// Slim sticky nav on every Base page. Section links point at homepage anchors.
// showName=false hides the name text where the page already shows it large (homepage hero).
const { showName = true } = Astro.props;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#journey', label: 'Journey' },
  { href: '/learning', label: 'Learning' },
  { href: '/resume', label: 'Resume' },
];
---

<header class="site-nav">
  <nav class="site-nav-inner container" aria-label="Main">
    <a href="/" class="site-brand" aria-label="Mark Vincent Palma, home">
      <span class="site-seal" aria-hidden="true">MVP</span>
      {showName && <span class="site-name">Mark Vincent Palma</span>}
    </a>
    <ul class="site-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
.site-nav {
  position: sticky;
  top: 0;
  z-index: 30;
  margin-bottom: var(--space-6);
  background: color-mix(in srgb, var(--paper) 94%, transparent);
  border-bottom: 1px solid var(--border);
}

.site-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  min-height: 60px;
}

.site-brand {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  flex-shrink: 0;
  color: var(--ink);
  font-weight: 700;
  text-decoration: none;
}

/* Hanko-style seal: the site's mark */
.site-seal {
  display: grid;
  place-items: center;
  width: 40px;
  height: 34px;
  border-radius: 7px;
  background: var(--accent);
  color: #FFF;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.28);
}

.site-links {
  display: flex;
  gap: var(--space-1);
  margin: 0;
  padding: 0;
  list-style: none;
  overflow-x: auto;
  scrollbar-width: none;
}

.site-links a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 var(--space-3);
  color: var(--ink-2);
  font-size: var(--text-sm);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}

.site-links a:hover {
  color: var(--accent-ink);
}

/* .site-links scrolls, which clips an outer ring, so draw the focus ring inside the link */
.site-links a:focus-visible {
  box-shadow: inset 0 0 0 2px var(--accent-ink);
}

@media (max-width: 640px) {
  .site-name {
    display: none;
  }

  .site-nav-inner {
    gap: var(--space-2);
  }

  .site-links a {
    padding: 0 0.3rem;
    font-size: var(--text-xs);
  }
}
</style>
